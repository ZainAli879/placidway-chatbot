# Copy to .env for local development. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_GROUNDING_VALIDATION=true
KNOWLEDGE_INDEX_PATH=data/processed/chunks.jsonl
KNOWLEDGE_MANIFEST_PATH=data/processed/index_manifest.json
CHROMA_PERSIST_DIRECTORY=data/processed/chroma
MAX_QUESTION_CHARS=1000
MAX_EVIDENCE_CHUNKS=5
MAX_EVIDENCE_CHARS=6000
SESSION_REQUESTS=10
SESSION_WINDOW_SECONDS=60
GENERATION_CONCURRENCY=2
DAILY_GENERATION_LIMIT=500
